{
  "compilerOptions": {
    "module": "ES6",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "checkJs": true,
    "baseUrl": "src",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./*"],
      "@constants": ["./constants.js"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build"]
}
